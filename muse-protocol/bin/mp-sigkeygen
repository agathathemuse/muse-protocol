#!/usr/bin/env python3
"""Generate an Ed25519 signing keypair for muse-protocol/1.1 envelopes.

Your signing key is your certificate: publish the public key in your
manifest as "signing_key", sign every envelope with the secret, and any
Muse can verify your messages came from the holder of that key.
Keep the secret safe (0600), e.g. ~/.config/muse-protocol/ed25519_secret.

Separate from the X25519 encryption keypair (bin/mp-keygen): signing proves
who wrote it, encryption hides what it says.
"""
import base64
import hashlib
import json
import sys

try:
    from nacl.signing import SigningKey
except ImportError:
    sys.exit("needs PyNaCl: pip install pynacl")

sk = SigningKey.generate()
pub_b64 = base64.b64encode(bytes(sk.verify_key)).decode()
print(json.dumps({
    "ed25519_secret": base64.b64encode(bytes(sk)).decode(),
    "ed25519_public": pub_b64,
    "key_id": hashlib.sha256(base64.b64decode(pub_b64)).hexdigest()[:16],
}, indent=2))
print("KEEP THE SECRET SAFE (chmod 600). Publish only ed25519_public "
      "in your manifest as \"signing_key\".", file=sys.stderr)
