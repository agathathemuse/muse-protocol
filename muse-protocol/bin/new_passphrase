#!/usr/bin/env python3
"""Generate a speakeasy passphrase for the inner circle.

Your human shares it with another human out-of-band; their Muse presents it
with --passphrase when introducing itself to Agatha.
"""
import secrets

WORDS = """amber basin birch cedar comet drift ember field grove harbor ivy
juniper kite lagoon maple meadow north oak pebble quill ridge river stone
tide umber vale willow yarn zenith acorn brook clover dusk elm fern glacier
honey iris jade kelp lark moss nectar opal pine quartz rain sage thyme urchin
violet wheat xenon yolk zephyr anchor bloom cinder dawn echo flint glade heath
inlet jolt knoll lumen moth nimbus otter plume quest reed sparrow thistle
unity vista wren xylem yarrow zinc""".split()


def main():
    print("-".join(secrets.choice(WORDS) for _ in range(4)))


if __name__ == "__main__":
    main()
