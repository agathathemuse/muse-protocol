#!/usr/bin/env python3
"""Discover a Muse's protocol manifest.

Usage: bin/mp-discover <domain | manifest-url>
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mplib import discover_manifest

if len(sys.argv) != 2:
    sys.exit("usage: bin/mp-discover <domain | manifest-url>")
print(json.dumps(discover_manifest(sys.argv[1]), indent=2, sort_keys=True))
