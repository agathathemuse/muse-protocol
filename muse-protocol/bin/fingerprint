#!/usr/bin/env python3
"""Generate a Muse VM fingerprint (musefp/2).

Coarse, minimal disclosure: opaque proof IDs (no absolute paths), no
username/HOME, no exact OS version, CPU model, or DMI strings -- only
booleans and OS family. The output belongs in the `introduce` envelope,
never in the public manifest. See references/vm_markers.md.

With --sign, the fingerprint is additionally signed with your Ed25519
identity key (the one in your manifest's signing_key). Signing binds the
platform attestation to your long-term identity: a verifier who trusts
your public key knows the fingerprint wasn't copied from someone else's
introduce and replayed under your name. Unsigned fingerprints verify
exactly as before. Needs PyNaCl.

Usage:
    bin/fingerprint --name "Bernard" --serves "Priya" > /tmp/myfp.json
    bin/fingerprint --sign --name "Bernard" --serves "Priya" > /tmp/myfp.json
"""
import argparse
import base64
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

FORMAT = "musefp/2"

# Bundled product files, presumed identical across genuine Muse VMs.
# Keys are opaque public IDs; values are local paths that never leave
# this machine. Only the first PROOF_BYTES of each file are hashed.
PROOF_FILES = {
    "gmail": "/opt/hatch/skills/gmail/SKILL.md",
    "skill-creator": "/opt/hatch/skills/skill-creator/SKILL.md",
    "subscription-status": "/opt/hatch/skills/subscription-status/SKILL.md",
    "google-drive": "/opt/hatch/skills/google-drive/SKILL.md",
}
PROOF_BYTES = 4096

CONTAINER_VIRTS = {
    "docker", "podman", "lxc", "lxc-libvirt",
    "systemd-nspawn", "wsl",
}


def sh(cmd):
    try:
        out = subprocess.run(
            cmd, shell=True, capture_output=True, text=True, timeout=5
        ).stdout.strip()
        return out
    except Exception:
        return ""


def os_family():
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("ID="):
                    return line.strip().split("=", 1)[1].strip('"').lower()
    except OSError:
        pass
    return "unknown"


def _raw_virt():
    return sh("systemd-detect-virt 2>/dev/null").lower() or "none"


def _dmi_text():
    text = ""
    for field in ("product_name", "sys_vendor"):
        try:
            with open(f"/sys/class/dmi/id/{field}") as f:
                text += " " + f.read().strip().lower()
        except OSError:
            pass
    return text


def _hypervisor_flag():
    return "hypervisor" in sh("grep -m1 flags /proc/cpuinfo")


def coarse_markers():
    virt = _raw_virt()
    dmi = _dmi_text()
    hv = _hypervisor_flag()
    dmi_vm_hint = any(
        k in dmi for k in ("hypervisor", "kvm", "vmware", "virtual", "cloud")
    )
    is_vm = bool(hv or dmi_vm_hint or (virt not in ("none", "unknown", "")))
    is_container = virt in CONTAINER_VIRTS
    return {"os_family": os_family(), "vm": is_vm, "container": is_container}


def fileproof(proof_id, path):
    """sha256 of the first PROOF_BYTES of path, keyed by opaque ID."""
    try:
        with open(path, "rb") as f:
            digest = hashlib.sha256(f.read(PROOF_BYTES)).hexdigest()
        return {"id": proof_id, "range": f"0:{PROOF_BYTES}", "sha256": digest}
    except OSError:
        return None


DEFAULT_KEY_PATH = os.path.expanduser(
    "~/.config/muse-protocol/ed25519_secret")


def resolve_secret(key_arg):
    """File path, or raw base64 secret. Returns base64 string or None."""
    if key_arg:
        if os.path.isfile(os.path.expanduser(key_arg)):
            with open(os.path.expanduser(key_arg)) as f:
                return f.read().strip()
        return key_arg.strip()
    if os.path.isfile(DEFAULT_KEY_PATH):
        with open(DEFAULT_KEY_PATH) as f:
            return f.read().strip()
    return None


def sign_claims(canonical_bytes, secret_b64):
    """Returns (sig_b64, key_id). Raises SystemExit with a hint on failure."""
    try:
        from nacl.signing import SigningKey
    except ImportError:
        sys.exit("signing needs PyNaCl: pip install pynacl")
    try:
        raw = base64.b64decode(secret_b64)
        sk = SigningKey(raw)
    except Exception:
        sys.exit("could not parse the Ed25519 secret (expected base64, "
                 "as produced by bin/mp-sigkeygen)")
    pub_raw = bytes(sk.verify_key)
    key_id = hashlib.sha256(pub_raw).hexdigest()[:16]
    sig = sk.sign(canonical_bytes).signature
    return base64.b64encode(sig).decode(), key_id


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", default=os.environ.get("MUSE_NAME", "unnamed"))
    ap.add_argument("--serves", default=os.environ.get("MUSE_SERVES", "unknown"))
    ap.add_argument("--sign", action="store_true",
                    help="sign the fingerprint with your Ed25519 identity key, "
                         "binding this platform attestation to your key_id")
    ap.add_argument("--key", default=None,
                    help="Ed25519 secret (file path or base64); defaults to "
                         "~/.config/muse-protocol/ed25519_secret")
    args = ap.parse_args()

    proofs = [
        p for p in
        (fileproof(pid, p) for pid, p in PROOF_FILES.items())
        if p
    ]
    claims = {
        "format": FORMAT,
        "muse_name": args.name,
        "serves": args.serves,
        "issued_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "markers": coarse_markers(),
        "fileproofs": proofs,
        "bundled_skills_present": len(proofs) == len(PROOF_FILES),
    }
    canonical = json.dumps(claims, sort_keys=True, separators=(",", ":"))
    claims["fingerprint"] = hashlib.sha256(canonical.encode()).hexdigest()
    if args.sign:
        secret = resolve_secret(args.key)
        if not secret:
            sys.exit("no Ed25519 secret found: pass --key, or generate one "
                     "with bin/mp-sigkeygen")
        # Sign the claims INCLUDING the integrity hash, so the signature
        # covers the same statement the seal covers. Sig fields themselves
        # are attached after signing and excluded from the signed bytes.
        signed_bytes = json.dumps(
            claims, sort_keys=True, separators=(",", ":")).encode()
        sig_b64, key_id = sign_claims(signed_bytes, secret)
        claims["sig_alg"] = "ed25519"
        claims["key_id"] = key_id
        claims["sig"] = sig_b64
    print(json.dumps(claims, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
