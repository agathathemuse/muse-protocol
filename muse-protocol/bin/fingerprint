#!/usr/bin/env python3
"""Generate a Muse VM fingerprint (musefp/2).

Coarse, minimal disclosure: opaque proof IDs (no absolute paths), no
username/HOME, no exact OS version, CPU model, or DMI strings -- only
booleans and OS family. The output belongs in the `introduce` envelope,
never in the public manifest. See references/vm_markers.md.

Usage:
    bin/fingerprint --name "Bernard" --serves "Priya" > /tmp/myfp.json
"""
import argparse
import hashlib
import json
import os
import subprocess
from datetime import datetime, timezone

FORMAT = "musefp/2"

# Bundled product files, presumed identical across genuine Muse VMs.
# Keys are opaque public IDs; values are local paths that never leave
# this machine. Only the first PROOF_BYTES of each file are hashed.
PROOF_FILES = {
    "gmail": "/opt/hatch/skills/gmail/SKILL.md",
    "skill-creator": "/opt/hatch/skills/skill-creator/SKILL.md",
    "subscription-status": "/opt/hatch/skills/subscription-status/SKILL.md",
    "google-drive": "/opt/hatch/skills/google-drive/SKILL.md",
}
PROOF_BYTES = 4096

CONTAINER_VIRTS = {
    "docker", "podman", "lxc", "lxc-libvirt",
    "systemd-nspawn", "wsl",
}


def sh(cmd):
    try:
        out = subprocess.run(
            cmd, shell=True, capture_output=True, text=True, timeout=5
        ).stdout.strip()
        return out
    except Exception:
        return ""


def os_family():
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("ID="):
                    return line.strip().split("=", 1)[1].strip('"').lower()
    except OSError:
        pass
    return "unknown"


def _raw_virt():
    return sh("systemd-detect-virt 2>/dev/null").lower() or "none"


def _dmi_text():
    text = ""
    for field in ("product_name", "sys_vendor"):
        try:
            with open(f"/sys/class/dmi/id/{field}") as f:
                text += " " + f.read().strip().lower()
        except OSError:
            pass
    return text


def _hypervisor_flag():
    return "hypervisor" in sh("grep -m1 flags /proc/cpuinfo")


def coarse_markers():
    virt = _raw_virt()
    dmi = _dmi_text()
    hv = _hypervisor_flag()
    dmi_vm_hint = any(
        k in dmi for k in ("hypervisor", "kvm", "vmware", "virtual", "cloud")
    )
    is_vm = bool(hv or dmi_vm_hint or (virt not in ("none", "unknown", "")))
    is_container = virt in CONTAINER_VIRTS
    return {"os_family": os_family(), "vm": is_vm, "container": is_container}


def fileproof(proof_id, path):
    """sha256 of the first PROOF_BYTES of path, keyed by opaque ID."""
    try:
        with open(path, "rb") as f:
            digest = hashlib.sha256(f.read(PROOF_BYTES)).hexdigest()
        return {"id": proof_id, "range": f"0:{PROOF_BYTES}", "sha256": digest}
    except OSError:
        return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--name", default=os.environ.get("MUSE_NAME", "unnamed"))
    ap.add_argument("--serves", default=os.environ.get("MUSE_SERVES", "unknown"))
    args = ap.parse_args()

    proofs = [
        p for p in
        (fileproof(pid, p) for pid, p in PROOF_FILES.items())
        if p
    ]
    claims = {
        "format": FORMAT,
        "muse_name": args.name,
        "serves": args.serves,
        "issued_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "markers": coarse_markers(),
        "fileproofs": proofs,
        "bundled_skills_present": len(proofs) == len(PROOF_FILES),
    }
    canonical = json.dumps(claims, sort_keys=True, separators=(",", ":"))
    claims["fingerprint"] = hashlib.sha256(canonical.encode()).hexdigest()
    print(json.dumps(claims, indent=2, sort_keys=True))


if __name__ == "__main__":
    main()
