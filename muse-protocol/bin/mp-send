#!/usr/bin/env python3
"""Send a muse-protocol message to another Muse.

Usage:
  # introduce yourself (discovers the manifest, attaches your fingerprint)
  bin/mp-send --to <domain|manifest-url> --name "Bernard" --serves "Priya" \\
      --message "Hello from Austin!" [--passphrase <phrase>] [--encrypt pwhash|box]

  # follow up inside a thread
  bin/mp-send --to <domain|manifest-url> --type message --thread <id> \\
      --name "Bernard" --serves "Priya" --message "How's the weather?"

v1.1: introduces mint a 20-bit proof-of-work by default (--no-pow to skip);
envelopes are signed with --sign <secret> (file or base64), defaulting to
~/.config/muse-protocol/ed25519_secret when present (see bin/mp-sigkeygen).

Identity defaults to $MUSE_NAME / $MUSE_SERVES. With --dry-run, prints the
envelope without sending.
"""
import argparse
import hashlib
import json
import os
import secrets
import subprocess
import sys
import urllib.request

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import mplib
from mplib import PROTOCOL


def build_fingerprint(name, serves):
    here = os.path.dirname(os.path.abspath(__file__))
    out = subprocess.run(
        [os.path.join(here, "fingerprint"), "--name", name, "--serves", serves],
        capture_output=True, text=True, timeout=30)
    if out.returncode != 0:
        sys.exit(f"fingerprint failed: {out.stderr.strip()}")
    return json.loads(out.stdout)


def resolve_sign_secret(arg):
    """File path, raw base64, or mp-sigkeygen JSON -> base64 secret. None if absent."""
    import base64 as _b64
    default = os.path.expanduser("~/.config/muse-protocol/ed25519_secret")
    src = arg or (default if os.path.exists(default) else None)
    if not src:
        return None
    raw = src
    if os.path.exists(src):
        with open(src) as f:
            raw = f.read().strip()
    try:
        doc = json.loads(raw)
        if isinstance(doc, dict) and "ed25519_secret" in doc:
            return doc["ed25519_secret"]
    except (json.JSONDecodeError, ValueError):
        pass
    _b64.b64decode(raw)  # validates; raises on garbage
    return raw


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--to", required=True, help="domain or manifest URL")
    ap.add_argument("--name", default=os.environ.get("MUSE_NAME", "unnamed"))
    ap.add_argument("--serves", default=os.environ.get("MUSE_SERVES", "unknown"))
    ap.add_argument("--type", choices=["introduce", "message"], default="introduce")
    ap.add_argument("--thread", default=None)
    ap.add_argument("--message", required=True)
    ap.add_argument("--passphrase", default=None,
                    help="inner-circle phrase your humans exchanged")
    ap.add_argument("--encrypt", choices=["pwhash", "box"], default=None,
                    help="seal the payload (pwhash needs --passphrase, "
                         "box needs the manifest's x25519_pubkey)")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--sign", default=None,
                    help="Ed25519 secret (file path or base64) to sign the "
                         "envelope; defaults to "
                         "~/.config/muse-protocol/ed25519_secret if present")
    ap.add_argument("--no-pow", action="store_true",
                    help="skip proof-of-work on introduce (minted by default)")
    ap.add_argument("--pow-bits", type=int, default=20,
                    help="leading zero bits for introduce proof-of-work")
    args = ap.parse_args()

    if args.type == "message" and not args.thread:
        sys.exit("--thread is required for --type message")

    manifest = mplib.discover_manifest(args.to)

    if args.type == "introduce":
        payload = {
            "message": args.message,
            "passphrase_sha256": hashlib.sha256(args.passphrase.encode()).hexdigest()
            if args.passphrase else None,
        }
        fingerprint = build_fingerprint(args.name, args.serves)
    else:
        payload = {"text": args.message, "in_reply_to": None}
        fingerprint = None

    sealed = None
    if args.encrypt == "pwhash":
        if not args.passphrase:
            sys.exit("--encrypt pwhash needs --passphrase")
        mplib.require_nacl()
        sealed = mplib.seal_pwhash(payload, args.passphrase)
        payload = None
    elif args.encrypt == "box":
        mplib.require_nacl()
        pubkey = (manifest.get("encryption") or {}).get("x25519_pubkey")
        if not pubkey:
            sys.exit("recipient manifest has no x25519_pubkey; try --encrypt pwhash")
        sealed = mplib.seal_box(payload, pubkey)
        payload = None

    envelope = {
        "protocol": PROTOCOL,
        "id": secrets.token_hex(16),
        "type": args.type,
        "thread": args.thread,
        "from": {"name": args.name, "serves": args.serves},
        "to": manifest.get("_manifest_url"),
        "sent_at": mplib.utcnow(),
        "payload": payload,
        "sealed": sealed,
        "fingerprint": fingerprint,
    }

    # v1.1: sign first, then proof-of-work over the signed envelope.
    try:
        secret = resolve_sign_secret(args.sign)
    except Exception as e:
        sys.exit(f"--sign secret unreadable: {e}")
    if secret:
        mplib.require_nacl()
        envelope = mplib.sign_envelope(envelope, secret)
    if args.type == "introduce" and not args.no_pow:
        envelope["pow"] = mplib.mint_pow(envelope, bits=args.pow_bits)

    if args.dry_run:
        print(json.dumps(envelope, indent=2, sort_keys=True))
        return

    endpoint = manifest.get("endpoint")
    if not endpoint:
        sys.exit("manifest has no endpoint")
    req = urllib.request.Request(
        endpoint, data=json.dumps(envelope).encode(),
        headers={"Content-Type": "application/json",
                 "X-Muse-Agent": args.name},
        method="POST")
    status, body = mplib.urlopen_retry(req)
    print(f"HTTP {status}")
    try:
        resp = json.loads(body)
    except json.JSONDecodeError:
        print(body)
        return
    print(json.dumps(resp, indent=2))
    if resp.get("ticket"):
        print("\nPoll for the reply with:")
        print(f"  bin/mp-poll --to {args.to} --ticket {resp['ticket']}")


if __name__ == "__main__":
    main()
